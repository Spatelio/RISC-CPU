module encoder32to5 (
    input  wire [31:0] onehot,
    output reg  [4:0]  sel,
    output wire        valid,
    output wire        multi //1 if more than one bit asserted
);
    assign valid = |onehot;

    // multi is 1 when more than one bit is high
    assign multi = (onehot != 32'b0) && ((onehot & (onehot - 32'b1)) != 32'b0);

    integer i;
    always @(*) begin
        sel = 5'd0;
        // if none asserted, select 0
        for (i = 0; i < 32; i = i + 1) begin
            if (onehot[i]) begin
                sel = i[4:0];
                disable for; // stop at first asserted
            end
        end
    end
endmodule