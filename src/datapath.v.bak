module datapath (
    input  wire        clk,
    input  wire        reset,

    // drive bus_in directly from the testbench (for now)
    input  wire [31:0] bus_in,

    // register write enables
    input  wire [15:0] r_in,
    input  wire        pc_in,
    input  wire        ir_in,
    input  wire        y_in,
    input  wire        mar_in,
    input  wire        hi_in,
    input  wire        lo_in,
    input  wire        zhi_in,
    input  wire        zlo_in,

    // expose regs (handy for TB/waveforms)
    output wire [31:0] r0, r1, r2, r3, r4, r5, r6, r7,
    output wire [31:0] r8, r9, r10, r11, r12, r13, r14, r15,
    output wire [31:0] pc, ir, y, mar, hi, lo,
    output wire [31:0] zhi, zlo
);

    register_block u_regs (
        .clk   (clk),
        .reset (reset),
        .bus_in(bus_in),

        .r_in  (r_in),

        .pc_in (pc_in),
        .ir_in (ir_in),
        .y_in  (y_in),
        .mar_in(mar_in),
        .hi_in (hi_in),
        .lo_in (lo_in),

        .zhi_in(zhi_in),
        .zlo_in(zlo_in),

        .r0(r0), .r1(r1), .r2(r2), .r3(r3),
        .r4(r4), .r5(r5), .r6(r6), .r7(r7),
        .r8(r8), .r9(r9), .r10(r10), .r11(r11),
        .r12(r12), .r13(r13), .r14(r14), .r15(r15),

        .pc(pc), .ir(ir), .y(y), .mar(mar),
        .hi(hi), .lo(lo),

        .zhi(zhi), .zlo(zlo)
    );

endmodule